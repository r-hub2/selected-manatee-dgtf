Package: dgtf
Type: Package
Title: Variational and Monte Carlo Inference for Bayesian State-Space
        Models of Count Data
Version: 0.1.0
Authors@R: c(
    person(given = "Meini", family = "Tang", role = c("aut", "cre"),
